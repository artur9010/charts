{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":semanticCommitScopeDisabled",
    "docker:enableMajor",
    "customManagers:helmChartYamlAppVersions",
    ":disableRateLimiting",
    ":ignoreUnstable",
    ":separateMultipleMajorReleases",
    ":updateNotScheduled"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Treat every chart as separate group with separate scope and branch prefix",
      "matchFileNames": [
        "charts/*/*"
      ],
      "additionalBranchPrefix": "{{parentDir}}-",
      "semanticCommitScope": "{{parentDir}}"
    },
    {
      "description": "Disable digest pinning for regex managers in Chart.yaml used for appVersion upgrading",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "charts/*/Chart.yaml"
      ],
      "pinDigests": false
    },
    {
      "description": "Bump helm chart versions by a patch, the release workflow publishes them after merge",
      "matchFileNames": [
        "charts/*/*"
      ],
      "bumpVersions": [
        {
          "name": "chart version",
          "filePatterns": [
            "{{packageFileDir}}/Chart.yaml"
          ],
          "matchStrings": [
            "(?m)^version:\\s*(?<version>\\S+)"
          ],
          "bumpType": "patch"
        }
      ]
    }
  ]
}
